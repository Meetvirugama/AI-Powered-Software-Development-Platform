# Frontend Environment Variables Template
# Copy to .env.local for local development

# Base URL for backend API v1 endpoints
# Local: http://localhost:8000/api/v1
# Production: leave empty to use relative /api/v1 rewrite, or point to production API
VITE_API_BASE_URL=http://localhost:8000/api/v1

# GitHub App Installation URL (optional override)
# e.g., https://github.com/apps/my-app-name/installations/new
VITE_GITHUB_APP_INSTALLATION_URL=

# GitHub App Slug (used if VITE_GITHUB_APP_INSTALLATION_URL is not set)
VITE_GITHUB_APP_SLUG=ai-dev-platform-local

# Mock Service Worker (MSW) for local development
# Set to 'true' to intercept API calls with mock handlers in development mode.
# Default: false (live backend API is used)
VITE_ENABLE_MSW=false


