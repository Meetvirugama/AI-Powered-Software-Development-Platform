# Application
APP_ENV=development
LOG_LEVEL=INFO

# Local services (matches docker-compose.yml)
DATABASE_URL=postgresql+psycopg://platform:platform@localhost:5432/agent_platform
REDIS_URL=redis://localhost:6379/0

# GitHub App / OAuth (leave blank until the integration is configured)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Authentication (use a long, random value locally; never commit a real secret)
JWT_SECRET=
JWT_ALGORITHM=HS256
