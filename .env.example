# Application
APP_ENV=development
LOG_LEVEL=INFO

# Local services (matches docker-compose.yml)
DATABASE_URL=postgresql+psycopg://platform:platform@localhost:5432/agent_platform
REDIS_URL=redis://localhost:6379/0

# GitHub App / OAuth
# See Docs/github_app_setup.md for how to register the App and obtain these values.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=      # Contents of the .pem file — escape newlines as \n
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=       # Random hex secret used to verify incoming webhooks
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback

# Clone workspace root (absolute path; defaults to system temp dir if not set)
GITHUB_WORKSPACE_ROOT=

# Authentication (use a long, random value locally; never commit a real secret)
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=15
AUTH_COOKIE_NAME=access_token
COOKIE_SECURE=false
DATABASE_PASSWORD=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
