# Application
APP_ENV=development
LOG_LEVEL=INFO

# Local services (matches docker-compose.yml: host port 5433)
DATABASE_URL=postgresql+psycopg://platform:platform@localhost:5433/agent_platform
REDIS_URL=redis://localhost:6379/0

# GitHub App / OAuth
# See Docs/github_app_setup.md for how to register the App and obtain these values.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=      # Contents of the .pem file — escape newlines as \n
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=       # Random hex secret used to verify incoming webhooks
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback

# Clone workspace root (absolute path; defaults to system temp dir if not set)
GITHUB_WORKSPACE_ROOT=

# Authentication (use a long, random value locally; never commit a real secret)
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=15
AUTH_COOKIE_NAME=access_token
COOKIE_SECURE=false

# API security (W1 Day 6)
# Comma-separated frontend origins allowed to call the API. Never use "*".
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_ENABLED=true
# Set true ONLY behind a trusted load balancer (enables X-Forwarded-For / X-Forwarded-Proto).
TRUST_PROXY_HEADERS=false

# AI / LLM Configuration (Gemini Primary, Groq Fallback)
AI_PRIMARY_PROVIDER=gemini
AI_FALLBACK_PROVIDER=groq

# Google Gemini API Keys (comma-separated for key rotation)
GEMINI_API_KEY=
GEMINI_API_KEYS=
GEMINI_CHAT_MODEL=gemini-flash-lite-latest

# Groq API Keys (comma-separated for key rotation)
GROQ_API_KEY=
GROQ_API_KEYS=
GROQ_CHAT_MODEL=openai/gpt-oss-120b

# AI Embeddings (Gemini)
AI_EMBEDDING_PROVIDER=gemini
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

