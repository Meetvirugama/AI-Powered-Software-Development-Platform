# =============================================================================
# Production Environment Variables Template
# Architecture: Vercel (Frontend) + Azure (Backend API) + Supabase (Postgres) + Upstash (Redis)
# =============================================================================

# --- 1. APPLICATION & RUNTIME (Set in Azure App Service Configuration) -------
APP_ENV=production
LOG_LEVEL=INFO
PORT=8000
# Azure App Service sets WEBSITES_PORT or PORT. Uvicorn will automatically bind to it.

# --- 2. SUPABASE POSTGRESQL & PGVECTOR ----------------------------------------
# Supabase provides connection strings under Project Settings -> Database -> Connection string.
# Supports both Session Pooler (port 5432) and Transaction Pooler (port 6543 / Supavisor).
# Note: Always include sslmode=require for Supabase cloud connections.
# Format: postgresql+psycopg://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql+psycopg://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# PostgreSQL connection pool tuning for cloud workloads
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# --- 3. UPSTASH SERVERLESS REDIS (TLS Required) ------------------------------
# From Upstash Console -> Database -> Details -> Connect -> 'rediss://...'
# Production requires rediss:// (TLS encrypted connection).
# Format: rediss://default:[UPSTASH_TOKEN]@[ENDPOINT].upstash.io:6379
REDIS_URL=rediss://default:[PASSWORD]@[ENDPOINT].upstash.io:6379

# --- 4. AUTHENTICATION & CROSS-ORIGIN COOKIES (Vercel <-> Azure) -------------
# JWT Secret: MUST be at least 32 cryptographically random characters in production.
# Generate with: openssl rand -hex 32
JWT_SECRET=generate-a-strong-32-character-secret-key-here-for-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
AUTH_COOKIE_NAME=access_token

# Cross-origin cookie configuration between Vercel and Azure:
# For browsers to send authentication cookies from https://<app>.vercel.app to https://<app>.azurewebsites.net,
# COOKIE_SECURE MUST be true and COOKIE_SAMESITE MUST be none.
COOKIE_SECURE=true
COOKIE_SAMESITE=none

# Frontend origin and CORS configuration:
FRONTEND_URL=https://[YOUR-APP].vercel.app
CORS_ALLOWED_ORIGINS=https://[YOUR-APP].vercel.app
# Permit preview branch deployments on Vercel:
CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# Azure runs behind ARR (Application Request Routing) reverse proxy.
# Enable trust_proxy_headers so X-Forwarded-Proto (https) and client IP are trusted:
TRUST_PROXY_HEADERS=true
RATE_LIMIT_ENABLED=true

# --- 5. GITHUB APP INTEGRATION ----------------------------------------------
# Register your GitHub App at https://github.com/settings/apps
# In GitHub App settings:
#   Homepage URL: https://[YOUR-APP].vercel.app
#   Callback URL: https://[YOUR-AZURE-APP].azurewebsites.net/api/v1/auth/github/callback
#   Webhook URL:  https://[YOUR-AZURE-APP].azurewebsites.net/api/v1/github/webhook
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
GITHUB_OAUTH_REDIRECT_URI=https://[YOUR-AZURE-APP].azurewebsites.net/api/v1/auth/github/callback

# --- 6. AI PROVIDERS (Gemini Primary, Groq Fallback) -------------------------
AI_PRIMARY_PROVIDER=gemini
AI_FALLBACK_PROVIDER=groq

# Google Gemini API
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-flash-lite-latest
AI_EMBEDDING_PROVIDER=gemini
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# Groq API (Fallback)
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-120b

# --- 7. SECURE SANDBOX & RUNNER CONFIGURATION (Issue #200 / F20) -------------
# In production, SANDBOX_BACKEND must be 'runner' (or 'container' on host). 'local' is strictly forbidden.
SANDBOX_BACKEND=runner
RUNNER_BASE_URL=https://[YOUR-RUNNER-VM-PRIVATE-IP]:8080
RUNNER_AUTH_SECRET=GENERATE_A_RANDOM_32_CHAR_SECRET_HERE
RUNNER_REQUEST_TIMEOUT=60.0
SANDBOX_CPU_LIMIT=2.0
SANDBOX_MEMORY_LIMIT=4g
SANDBOX_PID_LIMIT=512
SANDBOX_DISK_LIMIT_MB=500
SANDBOX_FILE_LIMIT_MB=5
SANDBOX_OUTPUT_LIMIT_BYTES=102400
SANDBOX_DEFAULT_TIMEOUT=30
SANDBOX_RUNTIME=runsc
SANDBOX_USE_GVISOR=true
SANDBOX_PYTHON_IMAGE=python:3.12-slim
SANDBOX_NODE_IMAGE=node:20-slim

# --- 8. VERCEL FRONTEND CONFIGURATION (Set in Vercel Project Settings) --------
# VITE_API_BASE_URL: Set to your Azure API endpoint or leave blank to use the /api/v1 rewrite
# VITE_API_BASE_URL=https://[YOUR-AZURE-APP].azurewebsites.net/api/v1
# VITE_GITHUB_APP_SLUG=[YOUR-GITHUB-APP-SLUG]
# VITE_ENABLE_MSW=false

